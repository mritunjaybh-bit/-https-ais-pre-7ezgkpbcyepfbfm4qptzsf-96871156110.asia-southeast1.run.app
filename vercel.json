{
  "rewrites": [
    {
      "source": "/api/create-order",
      "destination": "/api/payments?action=create-order"
    },
    {
      "source": "/api/verify-payment",
      "destination": "/api/payments?action=verify-payment"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/api/admin?subpath=$1"
    },
    {
      "source": "/api/orders/(.*)",
      "destination": "/api/orders?id=$1"
    },
    {
      "source": "/api/newsletter",
      "destination": "/api/subscribers"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
